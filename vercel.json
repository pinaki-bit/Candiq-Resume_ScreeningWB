{
  "buildCommand": "cd frontend_react && npm install && npm run build",
  "outputDirectory": "frontend_react/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://candiq-backend-oxa4.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
